# Copy this file to .env and fill in values. All of these are optional --
# the app runs fully in "simulate" mode without them (SMS/email are logged,
# not delivered, which is perfect for demos/dev).

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Port the server listens on (most hosts set this automatically)
PORT=3000

# Twilio and SendGrid credentials are entered per-agency inside the app at
# /dashboard/settings once you're logged in -- they are NOT read from this
# file. This file only controls SESSION_SECRET and PORT.
